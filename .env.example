# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# The anon/public key is safe to expose client-side — it's protected by
# Row Level Security policies (see supabase/schema.sql). Never put the
# service_role key here or in any client-side code.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
